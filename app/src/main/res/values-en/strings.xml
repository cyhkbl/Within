    <string name="app_name">Within</string>
    <string name="notification_service_label">Payment notifications</string>
    <string name="a11y_service_label">Payment screen reader</string>
    <string name="a11y_service_description">Reads the amount and payee from payment-completed screens in WeChat, Alipay and similar apps to prepare a draft entry. Nothing is uploaded.</string>
    <string name="autolog_00">Test merchant (manual trigger)</string>
    <string name="autolog_01">WeChat</string>
    <string name="autolog_02">Manual test: payment succeeded ¥28.80</string>
    <string name="autolog_03">Auto-record</string>
    <string name="autolog_04">Pops up a ready-to-confirm entry after you pay</string>
    <string name="autolog_05">How it works</string>
    <string name="autolog_06">Two independent detectors: one reads payment notifications from WeChat and Alipay, the other reads the amount on the payment result screen. Whichever fires first creates a draft with the amount, account, category and note already filled in — you only confirm.</string>
